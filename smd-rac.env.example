# smd-rac.env — credentials for the WsprDaemon RAC gateway.
#
# Copy this file to /etc/sigmond/smd-rac.env (or point SMD_RAC_ENV at it, or
# export these as real environment variables) before running `smd-rac install`.
# Do NOT commit the filled-in copy.
#
# Both values are the fleet-shared constants published in the upstream
# (public) WsprDaemon `smd`:  mijahauan/sigmond  →  bin/smd
#   _FRPC_TOKEN  →  WD_RAC_FRPS_TOKEN
#   FTP passwd   →  WD_RAC_FTP_PASSWD   (ftp_passwd in _bootstrap_rac_registration)

# frps [auth] token — required for `install` (written into frpc.toml).
WD_RAC_FRPS_TOKEN=

# Gateway FTP password — used once to auto-register a new station.
# Optional: if unset, install still configures and starts the tunnel; the
# station registers on its first spot upload instead.
WD_RAC_FTP_PASSWD=

# Gateway FTP user (optional; defaults to noisegraphs if unset).
#WD_RAC_FTP_USER=noisegraphs
